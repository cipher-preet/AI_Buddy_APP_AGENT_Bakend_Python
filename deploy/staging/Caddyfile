# Staging ingress only. Redis, MongoDB, and the worker are not routed.
# QUEUE_API_DOMAIN, PYTHON_API_DOMAIN, and NODE_API_DOMAIN must be DNS names
# the operator controls. ":80" is not a valid value.

{
	email {$CADDY_ACME_EMAIL}
}

{$QUEUE_API_DOMAIN} {
	encode gzip

	@events path /internal/events
	handle @events {
		request_body {
			max_size {$QUEUE_API_MAX_BODY_BYTES}
		}
		reverse_proxy queue-api:8080
	}

	handle /health/* {
		reverse_proxy queue-api:8080
	}

	respond 404
}

{$PYTHON_API_DOMAIN} {
	encode gzip
	reverse_proxy python-api:8080
}

{$NODE_API_DOMAIN} {
	encode gzip
	reverse_proxy node-api:5000
}
