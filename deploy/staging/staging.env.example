# Placeholder staging environment. Copy to a gitignored file on the staging host.
# Do not put production values here. Do not commit the copy.
# Run: python scripts/staging/phase2e2_preflight.py --env deploy/staging/staging.env.example --expect template

# Compose reads this path. A real start copies this file and changes the path to deploy/staging/staging.env.
STAGING_ENV_FILE=deploy/staging/staging.env.example
STAGING_MODE=local
STAGING_BIND_IP=127.0.0.1
STAGING_HTTP_PORT=8088
STAGING_HTTPS_PORT=8443

# Operator-owned names. example.invalid does not resolve. Replace all three together.
QUEUE_API_DOMAIN=queue.example.invalid
PYTHON_API_DOMAIN=api.example.invalid
NODE_API_DOMAIN=app.example.invalid
CADDY_ACME_EMAIL=staging-admin@example.invalid
QUEUE_API_MAX_BODY_BYTES=65536

APP_ENV=staging
SPEECH_VECTOR_QUEUE_TRANSPORT=list
WORKER_CONCURRENCY=1
JOB_LEASE_TTL_SECONDS=90
JOB_LEASE_HEARTBEAT_SECONDS=20

# One new value, identical on Node and Python. Not a production secret.
AUTH_TOKEN_SECRET=replace-with-staging-auth-token-secret
SESSION_SECRET=replace-with-staging-session-secret

# A different pair from the user token. Same values on Node, Python, and the Queue API.
QUEUE_API_SERVICE_TOKEN=replace-with-staging-queue-token
QUEUE_API_HMAC_SECRET=replace-with-staging-queue-hmac
# local mode uses the Docker DNS name. cloud mode must be https:// plus QUEUE_API_DOMAIN.
QUEUE_API_BASE_URL=http://queue-api:8080
QUEUE_PROVIDER=queue_api

REDIS_PASSWORD=replace-with-staging-worker-redis-password
REMINDER_REDIS_PASSWORD=replace-with-staging-reminder-redis-password
GOAL_REDIS_PASSWORD=replace-with-staging-goal-redis-password
# Forced onto the staging compose Redis by docker-compose.staging.yml for the worker and Queue API.
REDIS_URL=redis://:replace-with-staging-worker-redis-password@redis:6379/0
REMINDER_REDIS_URL=redis://:replace-with-staging-reminder-redis-password@redis-reminder:6379/0
GOAL_REDIS_URL=redis://:replace-with-staging-goal-redis-password@redis-goals:6379/0
MINDMAP_REDIS_URL=redis://:replace-with-staging-reminder-redis-password@redis-reminder:6379/0

MONGO_USER=staging
MONGO_PASSWORD=replace-with-staging-mongo-password
MONGO_URI=mongodb://staging:replace-with-staging-mongo-password@staging-mongo:27017/buddy?authSource=admin
MONGODB_URL=mongodb://staging:replace-with-staging-mongo-password@staging-mongo:27017/buddy?authSource=admin
MONGODB_DATABASE=buddy

# Local disk inside the staging containers. Leave the bucket empty until an
# operator creates a new bucket that cannot read production objects.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
S3_BUCKET=
S3_AUDIO_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FCM_ENABLED=false
DAILY_BRIEFING_ENABLED=true
QDRANT_URL=http://qdrant:6333

DEEPGRAM_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
